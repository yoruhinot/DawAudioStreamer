{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC デバッグ",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "architecture": "x64",
      "cacheVariables": {
        "DAS_BUILD_TESTS": "ON",
        "DAS_ENABLE_JUCE": "OFF"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC リリース",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package",
        "DAS_BUILD_TESTS": "ON",
        "DAS_BUILD_OBS_PLUGIN": "ON",
        "DAS_ENABLE_JUCE": "ON"
      }
    },
    {
      "name": "macos-preview-base",
      "hidden": true,
      "displayName": "macOSプレビュー版 (base)",
      "generator": "Xcode",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED": "NO",
        "DAS_DISPLAY_VERSION": "0.4.4-macos-preview.1",
        "DAS_COMPONENT_VERSION": "0.4.4",
        "DAS_BUILD_TESTS": "ON",
        "DAS_BUILD_ENGINE": "OFF",
        "DAS_BUILD_OBS_PLUGIN": "ON",
        "DAS_ENABLE_JUCE": "ON",
        "DAS_OBS_FRAMEWORK_DIR": "/Applications/OBS.app/Contents/Frameworks"
      }
    },
    {
      "name": "macos-preview-arm",
      "displayName": "macOSプレビュー版 (Apple Silicon)",
      "inherits": "macos-preview-base",
      "binaryDir": "${sourceDir}/build/macos-preview-arm",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/macos-package-arm"
      }
    },
    {
      "name": "macos-preview-intel",
      "displayName": "macOSプレビュー版 (Intel)",
      "inherits": "macos-preview-base",
      "binaryDir": "${sourceDir}/build/macos-preview-intel",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/macos-package-intel"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "configuration": "Release" },
    { "name": "macos-preview-arm", "configurePreset": "macos-preview-arm", "configuration": "Release" },
    { "name": "macos-preview-intel", "configurePreset": "macos-preview-intel", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-preview-arm",
      "configurePreset": "macos-preview-arm",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-preview-intel",
      "configurePreset": "macos-preview-intel",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
